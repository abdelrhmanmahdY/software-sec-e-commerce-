diff --git a/scripts/generate_certs.sh b/scripts/generate_certs.sh
new file mode 100755
index 0000000..dae1d44
--- /dev/null
+++ b/scripts/generate_certs.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+# Generates a SELF-SIGNED certificate for local/dev HTTPS (browsers will warn).
+# For production use a CA certificate - see docs/TLS_AAA.md (Let's Encrypt).
+set -euo pipefail
+
+CERT_DIR="${1:-certs}"
+DOMAIN="${DOMAIN:-localhost}"
+mkdir -p "$CERT_DIR"
+
+if [[ -f "$CERT_DIR/fullchain.pem" && -f "$CERT_DIR/privkey.pem" ]]; then
+  echo "Certificates already exist in $CERT_DIR (delete them to regenerate)."
+  exit 0
+fi
+
+openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 365 \
+  -keyout "$CERT_DIR/privkey.pem" -out "$CERT_DIR/fullchain.pem" \
+  -subj "/CN=${DOMAIN}" \
+  -addext "subjectAltName=DNS:${DOMAIN},DNS:localhost,IP:127.0.0.1"
+chmod 600 "$CERT_DIR/privkey.pem"
+echo "Created $CERT_DIR/fullchain.pem and $CERT_DIR/privkey.pem for ${DOMAIN}"
diff --git a/users/permissions.py b/users/permissions.py
new file mode 100644
index 0000000..fce96c2
--- /dev/null
+++ b/users/permissions.py
@@ -0,0 +1,35 @@
+"""Authorization helpers shared by the dashboard (session) views and the REST API."""
+from functools import wraps
+
+from django.core.exceptions import PermissionDenied
+from rest_framework.permissions import SAFE_METHODS, BasePermission
+
+
+def staff_required(view):
+    """Use *after* @login_required. Logged-in non-staff get a real 403
+    (which the audit middleware records) instead of a redirect loop."""
+
+    @wraps(view)
+    def wrapper(request, *args, **kwargs):
+        if not request.user.is_staff:
+            raise PermissionDenied
+        return view(request, *args, **kwargs)
+
+    return wrapper
+
+
+class IsStaff(BasePermission):
+    def has_permission(self, request, view):
+        return bool(request.user and request.user.is_authenticated and request.user.is_staff)
+
+
+class IsStaffOrCreateReadOnly(BasePermission):
+    """Any authenticated user may read (own data) and create; only staff may modify/delete."""
+
+    def has_permission(self, request, view):
+        user = request.user
+        if not (user and user.is_authenticated):
+            return False
+        if request.method in SAFE_METHODS or request.method == "POST":
+            return True
+        return user.is_staff
