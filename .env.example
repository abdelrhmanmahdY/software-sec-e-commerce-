SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=True

# Docker Compose PostgreSQL defaults
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_password
POSTGRES_PORT=5432

# The web container overrides DATABASE_URL automatically.
# For native/local PostgreSQL, use: postgres://nexus:nexus_password@localhost:5432/nexus
DATABASE_URL=
